-- Wed July 28 meeting

-- sequence is made up of parameters t (length of sample in seconds) and s (sample)
sequence_1 = {
    t [1,0.5,0.25];
    s gtr; -- or: s [gtr,bd]
}

-- Plays sequence_1 2 times 
Play 2 sequence_1  -- [("sequence_1",2)]
sequence_1 2
sequence_1.play
sequence_1.play(2)
play(sequence_1)
play(sequence_1,2)
play sequence_1 2 sequence_3 sequence_4 sequence_5 6
-- [("sequence_1",2),("sequence_3",1),("sequence_4",1),("sequence_5",6)]

-- everything above is notation examples...
-- everything below is PureScript data structures....

type Program = List Statement

data Statement =
  Sequence Sequence |
  Play (List (Tuple String Int))

type Sequence = Map String (List ParamValue)

data ParamValue =
  ParamNumber Number |
  ParamString String


-- examples of representing top examples using above data structure

Play ( Tuple "sequence_1" 2 : Nil )
Play ( Tuple "sequence_1" 2 : Tuple "sequence_3" 1 : Tuple "sequence_4" 1 : Tuple "sequence_5" 6 :  Nil)

Sequence (
  fromList [
    ("t", (ParamNumber 1 : ParamNumber 0.5 : ParamNumber 0.25 : Nil)),
    ("s", (ParamString "gtr" : Nil))
  ]
)

